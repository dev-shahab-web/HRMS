# =============================================================================
# HRMS SaaS — Environment Variables (EXAMPLE)
# Copy to `.env` (never commit real secrets). For Cloudflare Workers, secrets
# are set via `wrangler secret put` / `.dev.vars`, not this file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# One of: local | development | staging | production
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---------------------------------------------------
# Standard PostgreSQL connection string. In production this is fronted by
# Cloudflare Hyperdrive; the domain layer only ever sees a Postgres URL.
# For local dev/tests without a server, the DB layer falls back to in-process
# PGlite when DATABASE_URL is empty and APP_ENV=local (see packages/database).
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
# Hyperdrive binding id (Workers only; wrangler.jsonc references it)
HYPERDRIVE_ID=

# --- Auth / Sessions ---------------------------------------------------------
# 32+ byte random secret used to sign/verify session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=replace-me-with-a-long-random-secret
# Password hashing work factor (PBKDF2 iterations). See ADR-0004.
AUTH_PBKDF2_ITERATIONS=210000
SESSION_TTL_MINUTES=43200        # 30 days absolute
SESSION_IDLE_TTL_MINUTES=1440    # 24h idle timeout
ACCESS_TOKEN_TTL_MINUTES=15

# --- Application URLs --------------------------------------------------------
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787
PLATFORM_ADMIN_URL=http://localhost:5174
# Comma-separated list of allowed CORS origins for the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Cloudflare (set as Worker secrets/bindings in real envs) ----------------
CLOUDFLARE_ACCOUNT_ID=
# R2 (file storage) — bucket bound in wrangler; these are for local S3-compatible dev
R2_BUCKET=hrms-files-local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Turnstile (bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Provider abstractions (all optional; no-op/console providers used locally)
EMAIL_PROVIDER=console            # console | resend | ses | ...
EMAIL_FROM="HRMS <no-reply@example.com>"
RESEND_API_KEY=

PDF_PROVIDER=browser-run          # browser-run | none
SMS_PROVIDER=console
PUSH_PROVIDER=expo

# --- Billing (abstracted; not wired at foundation stage) ---------------------
BILLING_PROVIDER=manual           # manual | stripe | razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
